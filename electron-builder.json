{
  "appId": "com.marklens.reader",
  "productName": "MarkLens",
  "directories": {
    "output": "./dist-build"
  },
  "files": [
    "assets/**/*",
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "!node_modules/**/*"
  ],
  "compression": "normal",
  "afterPack": "scripts/afterPack.mjs",
  "win": {
    "target": ["nsis", "zip"],
    "icon": "assets/icon.ico",
    "artifactName": "MarkLens-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "runAfterFinish": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "artifactName": "MarkLens-Setup-${version}-${arch}.${ext}",
    "installerIcon": "assets/icon.ico",
    "uninstallerIcon": "assets/icon.ico",
    "installerHeaderIcon": "assets/icon.ico"
  },
  "portable": {
    "artifactName": "MarkLens-${version}-${arch}-portable.${ext}"
  },
  "msi": {
    "oneClick": false,
    "perMachine": true,
    "runAfterFinish": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "artifactName": "MarkLens-Enterprise-${version}-${arch}.${ext}"
  },
  "fileAssociations": [
    {
      "ext": "md",
      "name": "Markdown Document",
      "description": "Markdown Document",
      "icon": "assets/icon.ico",
      "role": "Editor"
    },
    {
      "ext": "markdown",
      "name": "Markdown Document",
      "description": "Markdown Document",
      "icon": "assets/icon.ico",
      "role": "Editor"
    },
    {
      "ext": "epub",
      "name": "EPUB Book",
      "description": "EPUB Electronic Book",
      "icon": "assets/icon.ico",
      "role": "Viewer"
    }
  ]
}
